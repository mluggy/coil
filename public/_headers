# Cache policy for routes excluded from the Pages Function (_routes.json):
# hashed bundles are immutable; everything else revalidates via the ETag
# Pages attaches to static assets. Mirrors the constants in
# functions/_middleware.js — keep the two in sync.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=3600, must-revalidate

/apple-touch-icon.png
  Cache-Control: public, max-age=3600, must-revalidate

/icon-192.png
  Cache-Control: public, max-age=3600, must-revalidate

/icon-512.png
  Cache-Control: public, max-age=3600, must-revalidate

/icon-maskable-192.png
  Cache-Control: public, max-age=3600, must-revalidate

/icon-maskable-512.png
  Cache-Control: public, max-age=3600, must-revalidate

/manifest.json
  Cache-Control: public, max-age=3600, must-revalidate

/cover.png
  Cache-Control: public, no-cache
